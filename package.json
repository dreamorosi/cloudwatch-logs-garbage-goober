{
  "name": "cloudwatch-logs-garbage-goober",
  "version": "0.0.1",
  "description": "Automated cleanup of CloudWatch Log Groups based on configurable patterns and tags",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "cdk": "cdk",
    "lint:fix": "biome check --write",
    "lint": "biome lint",
    "prepare": "husky"
  },
  "type": "module",
  "author": {
    "name": "Andrea Amorosi",
    "email": "dreamorosi@gmail.com"
  },
  "license": "MIT-0",
  "engines": {
    "node": ">=22.18.0"
  },
  "lint-staged": {
    "*.{ts,js,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@mrgrain/cdk-esbuild": "^5.8.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-cdk": "2.1139.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^7.1.0",
    "cdk-nag": "^2.37.55",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "~7.0.2",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@aws-lambda-powertools/batch": "^2.35.0",
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/metrics": "^2.35.0",
    "@aws-lambda-powertools/parameters": "^2.35.0",
    "@aws-lambda-powertools/parser": "^2.35.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1121.0",
    "@aws-sdk/client-scheduler": "^3.1121.0",
    "@aws-sdk/client-ssm": "^3.1121.0",
    "aws-cdk-lib": "2.267.0",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21",
    "temporal-polyfill": "^1.0.1",
    "zod": "^4.4.3"
  }
}
